# Copy this file to `.env.dev`, `.env.staging`, and `.env.prod`
# and fill in real values. Actual .env.* files are gitignored.
#
# Loaded at runtime by `EnvConfig.load()` via flutter_dotenv.
# The chosen flavor picks which file gets loaded (see lib/core/config/flavors.dart).

ENV_NAME=dev
BASE_URL=https://api.dev.example.com
API_KEY=replace_me
FIREBASE_ENABLED=false
